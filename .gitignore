# Avoid committing the duplicate delivery copy; Docker uses apps/server/public/assets.
komorebi-library/**/*.png
komorebi-library/**/*.jpg
komorebi-library/**/*.jpeg
komorebi-haetsal-asset-library.zip

# Real asset binaries (TICKET-007) — large/binary, folder structure kept via .gitkeep
# The runtime asset library is intentionally committed so a fresh machine can render.
!apps/server/public/assets/**/*.png
!apps/server/public/assets/**/*.jpg
!apps/server/public/assets/**/*.jpeg
