# Copy to apps/server/.env and adjust as needed.

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://komorebi:komorebi@localhost:5432/komorebi?schema=public"

# 'excel' = content_items are created only via Excel import (TICKET-003b), no Claude API calls.
# 'api'   = orchestrator calls Claude API directly (TICKET-003). Not implemented in this MVP yet.
CONTENT_SOURCE_MODE=excel

SERVER_PORT=4000

# Komachi production voice: No.7 読み聞かせ. Credit published audio as "VOICEVOX:No.7".
VOICEVOX_SPEAKER_ID=31

# Optional: override path to the crisis-keyword safeguard list (TICKET-005).
# CRISIS_KEYWORDS_PATH=./config/crisis-keywords.json

# Only required when CONTENT_SOURCE_MODE=api (TICKET-003) or when running
# scripts/weekly-content-headless.sh's *output* through TICKET-004's prompts directly via API
# instead of Claude Code. Not needed for CONTENT_SOURCE_MODE=excel.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override path to the SEO target-keyword table (TICKET-004b).
# SEO_KEYWORDS_PATH=./config/seo-keywords.json
