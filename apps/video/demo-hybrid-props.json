  "captionCues": [
    { "startSeconds": 0.1, "endSeconds": 4.84, "text": "안녕하세요. 햇살 편지의 보리예요." },
    { "startSeconds": 4.84, "endSeconds": 11.18, "text": "한국에서는 까치가 반가운 소식을 전해 주는 새로 오래 사랑받아 왔어요." },
    { "startSeconds": 11.18, "endSeconds": 15.99, "text": "오늘 제가 가져온 소식은 아주 작고 따뜻합니다." },
    { "startSeconds": 15.99, "endSeconds": 21.24, "text": "잠시 어깨의 힘을 빼고, 창밖의 빛을 바라보세요." },
    { "startSeconds": 21.24, "endSeconds": 27.5, "text": "천천히 숨을 들이쉬고 내쉬면서 오늘 잘해 낸 일 하나를 떠올려 보세요." },
    { "startSeconds": 27.5, "endSeconds": 33.45, "text": "따뜻한 차 한 잔, 반가운 인사 한마디도 충분히 소중합니다." },
    { "startSeconds": 33.45, "endSeconds": 37.97, "text": "오늘도 당신 곁에 좋은 소식이 머물기를 바라요." },
    { "startSeconds": 37.97, "endSeconds": 41.6, "text": "보리와 함께 편안한 하루 보내세요." }
  ],
