DATABASE_URL=postgresql://postgres:postgres@localhost:5432/komorebi
SERVER_PORT=4000
CONTENT_SOURCE_MODE=excel

# Keep false until each channel has passed one manual private/scheduled upload test.
YOUTUBE_AUTO_UPLOAD=false
YOUTUBE_UPLOAD_LOOKAHEAD_HOURS=168
YOUTUBE_UPLOAD_SWEEP_MINUTES=5

YOUTUBE_JP_CLIENT_ID=
YOUTUBE_JP_CLIENT_SECRET=
YOUTUBE_JP_REFRESH_TOKEN=
YOUTUBE_JP_REDIRECT_URI=http://localhost:4000/api/youtube/oauth/callback

YOUTUBE_KR_CLIENT_ID=
YOUTUBE_KR_CLIENT_SECRET=
YOUTUBE_KR_REFRESH_TOKEN=
YOUTUBE_KR_REDIRECT_URI=http://localhost:4000/api/youtube/oauth/callback
